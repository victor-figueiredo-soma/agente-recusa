# Gemini API (Google AI Studio - https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=sua_chave_aqui
GEMINI_MODEL=gemini-2.5-flash

# Google Sheets
# GOOGLE_CREDENTIALS_JSON: cole o conteúdo completo do JSON da Service Account (uma linha)
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
SPREADSHEET_ID=id_da_planilha_na_url_do_google_sheets
WORKSHEET_NAME=Emails Analisados

# BigQuery — leitura (validação de NF do Atacado) e armazenamento (chamados + custos)
# BQ_CREDENTIALS_JSON: JSON da Service Account com acesso ao BigQuery (uma linha).
# A SA precisa de leitura em soma-dl-refined-online.atacado_processed e de escrita
# (roles/bigquery.dataEditor) no dataset soma-dl-refined-online.control
# (tabelas: atacado_chamados_agente_recusa e atacado_custos_agente_recusa).
BQ_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# Microsoft Graph API — Registro de Aplicativo no Azure (App Registration)
AZURE_TENANT_ID=id_do_tenant_azure
AZURE_CLIENT_ID=id_do_app_registration
AZURE_CLIENT_SECRET=secret_do_app_registration
MAILBOX_USER_ID=email_ou_id_da_caixa_monitorada@somagrupo.com.br

# URL pública do agente (usada para registrar a subscription no Graph API)
WEBHOOK_BASE_URL=https://agente-recusa.azurewebsites.net

# Email interno que receberá o aviso de chamado criado (reply na mesma thread)
NOTIFICATION_EMAIL=logistica.atacado@somagrupo.com.br

# Filtros de entrada
# FILTER_IGNORE_FROM: emails desse remetente são descartados sem avaliação
FILTER_IGNORE_FROM=email_user@somagrupo.com.br
# MAILBOX_TARGET_EMAIL: só processa emails cujo campo "Para:" contenha esse endereço
MAILBOX_TARGET_EMAIL=email_destino_monitorado@somagrupo.com.br

# WiseReturn — criação automática do Boletim de Devolução (BD) da NF recusada
# WISERETURN_API_KEY: chave fixa do header X-External-Key, fornecida pelo time
# WiseReturn. SEM esta variável a integração é um no-op silencioso (nenhum BD é
# criado) — Sheets, BigQuery e o e-mail de resumo seguem funcionando normalmente.
WISERETURN_API_KEY=chave_x_external_key_fornecida_pelo_time_wisereturn
# WISERETURN_API_URL: sobrescreva apenas para apontar homologação. Padrão:
# https://wisereturnapi-soma.azurewebsites.net/service.asmx/external/importacaoRecusa/bds
# WISERETURN_API_URL=

# Alertas e segurança do webhook (lidos pelo código, faltavam neste exemplo)
# ALERT_EMAIL: recebe e-mail automático a cada log de nível ERROR (utils/logger.py)
ALERT_EMAIL=alertas.atacado@somagrupo.com.br
# WEBHOOK_CLIENT_STATE: segredo compartilhado com o Graph; notificação com
# clientState diferente é descartada
WEBHOOK_CLIENT_STATE=segredo_aleatorio_compartilhado_com_o_graph
# RENEW_API_KEY: valor esperado no header X-API-Key de POST /subscriptions/renew
RENEW_API_KEY=chave_para_renovacao_manual_da_subscription
