# Gemini API (Google AI Studio - https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=sua_chave_aqui
GEMINI_MODEL=gemini-2.5-flash

# Google Sheets
# GOOGLE_CREDENTIALS_JSON: cole o conteúdo completo do JSON da Service Account (uma linha)
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
SPREADSHEET_ID=id_da_planilha_na_url_do_google_sheets
WORKSHEET_NAME=Emails Analisados

# Microsoft Graph API — Registro de Aplicativo no Azure (App Registration)
AZURE_TENANT_ID=id_do_tenant_azure
AZURE_CLIENT_ID=id_do_app_registration
AZURE_CLIENT_SECRET=secret_do_app_registration
MAILBOX_USER_ID=email_ou_id_da_caixa_monitorada@somagrupo.com.br

# URL pública do agente (usada para registrar a subscription no Graph API)
WEBHOOK_BASE_URL=https://agente-recusa.azurewebsites.net

# Email interno que receberá o aviso de chamado criado (reply na mesma thread)
NOTIFICATION_EMAIL=logistica.atacado@somagrupo.com.br

# Filtros de entrada
# FILTER_IGNORE_FROM: emails desse remetente são descartados sem avaliação
FILTER_IGNORE_FROM=leonardo.horn@somagrupo.com.br
# MAILBOX_TARGET_EMAIL: só processa emails cujo campo "Para:" contenha esse endereço
MAILBOX_TARGET_EMAIL=email_destino_monitorado@somagrupo.com.br
