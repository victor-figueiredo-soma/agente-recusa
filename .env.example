# Gemini API (Google AI Studio - https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=sua_chave_aqui
GEMINI_MODEL=gemini-2.0-flash

# Google Sheets
# GOOGLE_CREDENTIALS_JSON: cole o conteúdo completo do JSON da Service Account (uma linha)
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
SPREADSHEET_ID=id_da_planilha_na_url_do_google_sheets
WORKSHEET_NAME=Emails Analisados

# Notificação interna — email que receberá o aviso de chamado criado (sempre na mesma thread)
NOTIFICATION_EMAIL=leonardo.horn@somagrupo.com.br

# Segurança do webhook — chave enviada pelo Power Automate no header X-Webhook-Secret
WEBHOOK_SECRET=gere_uma_chave_forte_aqui
